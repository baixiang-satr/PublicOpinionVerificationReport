# =============================================================================
# 舆情验证报告工具 — 环境变量配置
# =============================================================================
# 复制此文件为 .env 并根据需要修改配置。
# 参考 MediaCrawler 的配置管理方式。
# =============================================================================

# ── 基础抓取配置 ──────────────────────────────────────────────────────
# 同时处理的最大页面数 (1-10)
# POR_MAX_CONCURRENCY=3
# 单个页面最长等待时间（秒）
# POR_PAGE_TIMEOUT_SECONDS=30
# 失败后重试次数
# POR_MAX_RETRIES=2
# 重试基础延迟（秒），每次重试翻倍
# POR_RETRY_BASE_DELAY_SECONDS=2.0
# 同一域名最小访问间隔（秒）
# POR_MIN_HOST_INTERVAL_SECONDS=3.0
# 页面加载后的稳定等待时间（毫秒）
# POR_PAGE_STABILIZE_MILLISECONDS=1500

# ── 截图配置 ──────────────────────────────────────────────────────────
# 截图格式: jpeg 或 png
# POR_SCREENSHOT_FORMAT=jpeg
# 是否截取整页截图
# POR_FULL_PAGE_SCREENSHOT=true
# 整页截图最大高度；超过后仅保留顶部证据区域，避免无限滚动页产生超大文件
# POR_MAX_FULL_PAGE_SCREENSHOT_HEIGHT=4096
# 普通 JPEG / 长页面 JPEG 质量（长页面质量不得高于普通质量）
# POR_SCREENSHOT_JPEG_QUALITY=90
# POR_LONG_PAGE_JPEG_QUALITY=82
# 每页最多下载几张可信正文图片作为临时 OCR 输入（不会进入 ZIP）
# POR_MAX_IMAGES_PER_RECORD=6
# 每张图片大小上限（字节）
# POR_MAX_IMAGE_BYTES=10485760

# ── 浏览器模式 ────────────────────────────────────────────────────────
# 是否后台运行浏览器（true=无界面, false=显示窗口）
# POR_HEADLESS=true
# 逐平台加密登录态目录。默认位于当前 Windows 用户的 LocalAppData，
# 每个平台独立保存，且必须通过新 context 复验后才会提交。
# POR_AUTH_STORE_DIR=
# 旧版综合 Playwright storage state JSON，仅用于兼容/迁移。
# POR_STORAGE_STATE_PATH=
# 登录态管理器等待人工登录/扫码/验证码的时间（秒）
# POR_MANUAL_INTERVENTION_TIMEOUT_SECONDS=90

# ── OCR 识别 ──────────────────────────────────────────────────────────
# 是否启用 OCR 从图片提取文字
# POR_OCR_ENABLED=true
# OCR 置信度阈值 (0.0-1.0)
# POR_OCR_CONFIDENCE=0.5
# 独立 OCR Python；留空时自动使用项目 .ocr-venv/Scripts/python.exe
# POR_OCR_PYTHON_EXECUTABLE=
# 单批 OCR 超时、子进程自动重启次数
# POR_OCR_WORKER_TIMEOUT_SECONDS=45
# POR_OCR_MAX_RESTARTS=1
# 正文图片最小可见宽高
# POR_OCR_MIN_IMAGE_WIDTH=80
# POR_OCR_MIN_IMAGE_HEIGHT=80

# ── 内容导出 ──────────────────────────────────────────────────────────
# 界面/报告摘要长度；不会再限制 Excel 正文
# POR_SUMMARY_MAX_CHARS=2000
# Excel 信息内容安全上限（Excel 单元格硬上限为 32767）
# POR_EXPORT_CONTENT_MAX_CHARS=32000

# ── 反检测 / 反爬虫对抗配置 ──────────────────────────────────────────
# 参考 MediaCrawler 的反爬虫对抗策略

# 是否注入 stealth.min.js 来隐藏 Playwright 自动化痕迹
# 参考 MediaCrawler: browser_context.add_init_script(path="libs/stealth.min.js")
# 设为 false 可关闭（不推荐）
# POR_ENABLE_STEALTH=true

# 是否应用额外的 JS 补丁（webdriver、permissions 覆盖等）
# POR_ENABLE_EXTRA_STEALTH=true

# 代理服务器 URL（可选，用于绕过 IP 限制）
# 参考 MediaCrawler 的 ProxyIpPool 自动轮换代理
# 格式: http://user:password@host:port
#       https://user:password@host:port
#       socks5://user:password@host:port
# POR_PROXY_URL=

# 自定义 User-Agent（留空则自动随机选择）
# 参考 MediaCrawler 的 get_user_agent() 随机化策略
# POR_USER_AGENT=

# 浏览器视口宽度（基础值，会自动 ±20 随机偏移）
# POR_VIEWPORT_WIDTH=1440
# 浏览器视口高度（基础值，会自动 ±10 随机偏移）
# POR_VIEWPORT_HEIGHT=900

# 额外的 Chromium 启动参数（逗号分隔）
# 例如: --disable-webgl,--window-size=1920,1080
# POR_EXTRA_CHROMIUM_ARGS=
