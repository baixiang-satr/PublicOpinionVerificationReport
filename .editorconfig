# =============================================================================
# EditorConfig — 跨编辑器代码风格统一配置
# =============================================================================
# 让不同 IDE/编辑器（VS Code、PyCharm、Sublime 等）自动遵循相同的
# 缩进、编码、换行符规则，避免团队成员之间因编辑器差异产生格式混乱。
#
# 参考: https://editorconfig.org
# =============================================================================

root = true

# -----------------------------------------------------------------------------
# 全局默认规则
# -----------------------------------------------------------------------------
[*]
charset = utf-8                           # 文件编码统一 UTF-8
end_of_line = lf                          # 换行符使用 LF（跨平台兼容）
indent_style = space                      # 缩进使用空格（Python 标准）
indent_size = 4                           # 缩进宽度 4 格（PEP 8）
insert_final_newline = true               # 文件末尾保留一个空行
trim_trailing_whitespace = true           # 自动删除行尾多余空格
max_line_length = 120                     # 单行最大长度（参考 PEP 8 宽松版）

# -----------------------------------------------------------------------------
# Python 文件特殊规则
# -----------------------------------------------------------------------------
[*.py]
indent_size = 4                           # PEP 8 强制 4 空格缩进
max_line_length = 120                     # 允许适当放宽到 120 字符

# -----------------------------------------------------------------------------
# Markdown 文件特殊规则
# -----------------------------------------------------------------------------
[*.md]
trim_trailing_whitespace = false          # Markdown 中保留行尾空格有意义
max_line_length = 0                       # 不对 Markdown 做行长度限制

# -----------------------------------------------------------------------------
# YAML 文件特殊规则
# -----------------------------------------------------------------------------
[*.{yml,yaml}]
indent_size = 2                           # YAML 标准使用 2 空格缩进

# -----------------------------------------------------------------------------
# JSON 文件特殊规则
# -----------------------------------------------------------------------------
[*.json]
indent_size = 2                           # JSON 常用 2 空格缩进

# -----------------------------------------------------------------------------
# 批处理 / Shell 脚本
# -----------------------------------------------------------------------------
[*.{bat,cmd,ps1,sh}]
end_of_line = lf
indent_size = 4
