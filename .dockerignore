# =============================================================================
# Docker 构建忽略规则
# =============================================================================
# 构建 Docker 镜像时，以下文件/目录不会被发送到 Docker daemon，
# 可有效减小 Context 体积、加快构建速度。
# =============================================================================

.git/
.gitignore
.editorconfig
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# 虚拟环境（应当在 Dockerfile 内重新安装）
.venv/
venv/
env/

# 输出目录（不需要打包进镜像）
output/

# 日志
logs/
*.log

# 本地测试文件
tests/
docs/

# 开发工具文件
.vscode/
.idea/
*.swp

# 操作系统的隐藏文件
.DS_Store
Thumbs.db
